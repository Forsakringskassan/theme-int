{
  "name": "@fkui-community/theme-int",
  "version": "1.0.6",
  "description": "FKUI Community Theme Internal",
  "keywords": [
    "fkui",
    "theme"
  ],
  "homepage": "https://github.com/Forsakringskassan/theme-int",
  "bugs": "https://github.com/Forsakringskassan/theme-int/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forsakringskassan/theme-int.git"
  },
  "license": "MIT",
  "author": "Försäkringskassan",
  "type": "module",
  "exports": {
    ".": {
      "sass": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./auto": {
      "sass": "./dist/auto.css",
      "default": "./dist/auto.css"
    }
  },
  "types": "",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "fkui-theme-builder",
    "eslint": "eslint --cache .",
    "eslint:fix": "eslint --fix .",
    "lint": "npm run eslint && npm run prettier:check && npm run stylelint",
    "lint:fix": "npm run eslint:fix && npm run prettier:write && npm run stylelint:fix",
    "prepare": "commitlint-config",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
    "stylelint:fix": "npm run stylelint -- --fix",
    "pretest": "npm run lint",
    "test": ""
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": true
  },
  "commitlint": {
    "extends": "@forsakringskassan/commitlint-config/no-jira"
  },
  "prettier": "@forsakringskassan/prettier-config",
  "release": {
    "extends": "@forsakringskassan/semantic-release-config"
  },
  "stylelint": {
    "extends": [
      "@forsakringskassan/stylelint-config"
    ]
  },
  "dependencies": {
    "@fkui/theme-default": "6.66.0"
  },
  "devDependencies": {
    "@fkui/theme-builder": "6.66.0",
    "@forsakringskassan/commitlint-config": "4.2.8",
    "@forsakringskassan/eslint-config": "15.13.18",
    "@forsakringskassan/eslint-config-typescript": "15.13.15",
    "@forsakringskassan/prettier-config": "3.7.15",
    "@forsakringskassan/stylelint-config": "3.6.1",
    "npm-pkg-lint": "5.5.0",
    "sass": "1.108.2"
  },
  "peerDependencies": {
    "@fkui/design": "*"
  },
  "peerDependenciesMeta": {
    "@fkui/design": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.16 || >= 24",
    "npm": ">=11.0.0"
  }
}
